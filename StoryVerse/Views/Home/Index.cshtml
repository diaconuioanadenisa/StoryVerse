@{
    ViewData["Title"] = "Home Page";
}

<style>
   
    .hero-home {
        padding: 100px 20px;
        text-align: center;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/books.jpg');
        background-size: cover;
        background-position: center;
        color: white;
    }

   
    .story-card {
        border: 1px solid #eee;
        padding: 20px;
        border-radius: 15px;
        background: #fffcf9;
        transition: transform 0.3s ease, box-shadow 0.3s ease; 
        height: 100%;
    }

        .story-card:hover {
            transform: translateY(-8px); /* Săritura în sus */
            box-shadow: 0 10px 20px rgba(139, 94, 60, 0.15); /* O umbră maro fină care apare dedesubt */
        }

    /* Efectul de hover pentru Genuri (Categorii) */
    .category-badge {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 30px;
        font-weight: 600;
        transition: transform 0.2s ease, opacity 0.2s ease;
        cursor: pointer;
    }

        .category-badge:hover {
            transform: translateY(-4px); /* O săritură mai mică */
            opacity: 0.8;
        }
</style>

<div class="hero-home">
    <h1 style="font-family: 'Playfair Display', serif; font-size: 50px; text-transform: uppercase;">Discover and Publish Original Stories</h1>
    <p style="font-size: 20px; font-style: italic;">A digital library where readers and authors meet</p>
    <a asp-controller="Stories" asp-action="Index" class="btn" style="background: #8b5e3c; color: white; padding: 12px 30px; border-radius: 10px; margin-top: 20px;">Explore stories</a>
</div>

<div class="container" style="margin-top: -50px;">
    <div class="section-card" style="background: white; border-radius: 20px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        
        <h2 style="font-family: 'Playfair Display', serif; color: #4a2f21; margin-bottom: 30px;">Popular stories</h2>
        
        <div class="row mb-5">
            <div class="col-md-4 mb-3">
                <div class="story-card">
                    <h4 style="color: #4a2f21;">The Moon Shadow</h4>
                    <small style="color: #8b5e3c;">Fantasy • de Rory Gilmore</small>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="story-card">
                    <h4 style="color: #4a2f21;">Into The Woods</h4>
                    <small style="color: #8b5e3c;">Mystery • de Jenna Morgan</small>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="story-card">
                    <h4 style="color: #4a2f21;">Last Call</h4>
                    <small style="color: #8b5e3c;">Drama • de Mia Gregory</small>
                </div>
            </div>
        </div>

        <hr style="opacity: 0.1;">

        <h2 style="font-family: 'Playfair Display', serif; color: #4a2f21; margin-top: 30px; margin-bottom: 20px;">Categories</h2>
        
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <span class="category-badge" style="background: #f3e5f5; color: #7b1fa2;">Fantasy</span>
            <span class="category-badge" style="background: #fce4ec; color: #c2185b;">Romance</span>
            <span class="category-badge" style="background: #f3e5f5; color: #7b1fa2;">Horror</span>
            <span class="category-badge" style="background: #e8eaf6; color: #303f9f;">Adventure</span>
            <span class="category-badge" style="background: #f3e5f5; color: #7b1fa2;">Mystery</span>
            <span class="category-badge" style="background: #f3e5f5; color: #7b1fa2;">Classic</span>
            
            <a asp-controller="Categories" asp-action="Index" style="margin-left: auto; color: #8b5e3c; font-size: 0.8em; text-decoration: none; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">[ Manage Categories ]</a>
        </div>
    </div>
</div>