@model IEnumerable<StoryVerse.Models.Category>

@{
    ViewData["Title"] = "Manage Genres";
}

<div class="container mt-4">
    <h1 style="font-family: 'Playfair Display', serif; color: #4a2f21;">Genre Management</h1>

    <p>
        <a asp-action="Create" class="btn" style="background: #8b5e3c; color: white; border-radius: 10px;">+ Add Category</a>
    </p>

    <table class="table" style="background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
        <thead style="background: #4a2f21; color: white;">
            <tr>
                <th>
                    Genre
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: bold; color: #8b5e3c;">
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" style="color: #8b5e3c; text-decoration: none;">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id" style="color: #8b5e3c; text-decoration: none;">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id" style="color: #d9534f; text-decoration: none;">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" style="color: #666; text-decoration: none;">← Back to Home</a>
    </div>
</div>