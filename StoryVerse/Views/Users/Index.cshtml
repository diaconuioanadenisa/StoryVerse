@model IEnumerable<StoryVerse.Models.User>

@{
    ViewData["Title"] = "Users Admin";
}

<div class="container mt-5" style="min-height: 75vh; padding: 20px;">
    <h2 style="font-family: 'Playfair Display', serif; color: #4a2f21; margin-bottom: 25px;">User Management (Admin Panel)</h2>
    
    <div style="background: white; border-radius: 15px; padding: 25px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); overflow-x: auto; border: 1px solid #e2d5cc;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="background: #4a2f21; color: white;">
                    <th style="padding: 15px; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">Username</th>
                    <th style="padding: 15px;">Email</th>
                    <th style="padding: 15px;">Password</th>
                    <th style="padding: 15px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 15px; font-weight: bold; color: #4a2f21;">@item.Username</td>
                        <td style="padding: 15px; color: #666;">@item.Email</td>
                        
                        <td style="padding: 15px; font-family: monospace; letter-spacing: 3px; color: #8b5e3c; font-size: 1.1rem;">••••••••</td>
                        
                        <td style="padding: 15px; text-align: center;">
                            <a asp-action="Edit" asp-route-id="@item.Id" style="color: #8b5e3c; text-decoration: none; margin: 0 5px; font-weight: bold;">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.Id" style="color: #a3765d; text-decoration: none; margin: 0 5px; font-weight: bold;">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id" style="color: #d9534f; text-decoration: none; margin: 0 5px; font-weight: bold;">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>